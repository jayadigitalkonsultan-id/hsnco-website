APP_NAME=HSNCO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_DISPLAY_TIMEZONE=Asia/Jakarta
ADMIN_LOCAL_PREVIEW=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hsnco
DB_USERNAME=root
DB_PASSWORD=
DB_DUMP_BINARY=mysqldump

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Enquiry notification recipients (comma-separated; configure only approved inboxes).
ENQUIRY_NOTIFY_TO=
ENQUIRY_NOTIFICATION_QUEUE=emails
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
ENQUIRY_RETENTION_DAYS=365

SECURITY_LOGIN_ATTEMPTS_PER_MINUTE=5
SECURITY_LOGIN_IP_ATTEMPTS_PER_MINUTE=20
SECURITY_LOGIN_FAILURES_BEFORE_LOCK=5
SECURITY_LOGIN_FAILURE_WINDOW_MINUTES=15
SECURITY_LOGIN_LOCK_MINUTES=15
SECURITY_INVITATION_EXPIRES_MINUTES=60
SECURITY_INVITATION_RESEND_SECONDS=60
SECURITY_OTP_EXPIRES_MINUTES=5
SECURITY_OTP_MAX_ATTEMPTS=5
SECURITY_OTP_RESEND_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
