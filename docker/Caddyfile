{
    auto_https off
    admin off
    frankenphp
}

:8080 {
    root * /app/public
    encode zstd gzip

    @hidden path_regexp hidden (^|/)\.
    respond @hidden 404
    @uploaded_script path_regexp uploaded_script (?i)^/storage/.*\.(php[0-9]?|phtml|pht|phar|phps|cgi|pl|py|sh)(/.*)?$
    respond @uploaded_script 404

    header /storage/media/* X-Content-Type-Options "nosniff"

    php_server
    log {
        output stdout
        format json
    }
}
