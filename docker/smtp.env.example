# Copy these settings to the application Environment after choosing a mail provider.
# Values are placeholders; obtain real settings from that provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="HSNCO"
# For implicit TLS on port 465 use MAIL_SCHEME=smtps instead.
# Remove an old MAIL_URL if using the separate settings above.
# Quote passwords containing #, spaces, or other dotenv special characters.