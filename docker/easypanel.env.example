APP_NAME=HSNCO
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hsncoatlaw.com
ASSET_URL=https://hsncoatlaw.com
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
TRUSTED_PROXIES=*

# Configure approved mail transport credentials and recipient before enabling notifications.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=HSNCO
ENQUIRY_NOTIFY_TO=
ENQUIRY_NOTIFICATION_QUEUE=emails
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
ENQUIRY_RETENTION_DAYS=365

# CMS database service; inject real credentials in EasyPanel, never commit them.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hsnco
DB_USERNAME=hsnco
DB_PASSWORD=
APP_DISPLAY_TIMEZONE=Asia/Jakarta
